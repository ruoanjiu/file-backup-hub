APP_NAME=file-backup-server
APP_ENV=production
DATABASE_URL=sqlite:////data/file-backup/db/app.sqlite
STORAGE_ROOT=/data/file-backup/storage
MANIFEST_ROOT=/data/file-backup/manifests
MAX_UPLOAD_SIZE_MB=2048
DEFAULT_RETENTION_DAYS=90
SERVER_ADMIN_TOKEN=replace-with-a-long-random-admin-token
CLIENT_TOKENS=pc1:replace-with-pc1-token,pc2:replace-with-pc2-token,pc3:replace-with-pc3-token
